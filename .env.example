# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────
# Project URL and anon key are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key is server-only. Never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Stripe ────────────────────────────────────────────────
# Publishable key is safe to expose in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key and webhook secret are server-only. Never send to the browser.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID for Noetune Professional — Plus monthly (USD $9.99/month).
# Create this in your Stripe dashboard and paste the price_... ID here.
STRIPE_PRICE_PLUS_MONTHLY=price_...

# ── PostHog ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://noetune.com
