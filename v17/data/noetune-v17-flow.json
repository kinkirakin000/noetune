{
  "version": "4.0",
  "appVersion": "v17",
  "localeSource": "locales/{locale}.json",
  "themeSource": "v17/data/theme-library-{locale}.json",
  "sequence": [
    {
      "id": "step0",
      "screen": "themeSelection",
      "quoteSource": null,
      "skippable": true
    },
    {
      "id": "step1",
      "screen": "initialThemeMeasurement",
      "quoteSource": "theme",
      "skippable": true
    },
    {
      "id": "step2",
      "screen": "feelHundredTheme",
      "quoteSource": "theme",
      "skippable": true
    },
    {
      "id": "step3",
      "screen": "currentStateInput",
      "quoteSource": "theme",
      "responseTarget": "currentStateText",
      "skippable": true
    },
    {
      "id": "step4",
      "screen": "currentStateMeasurement",
      "quoteSource": "currentStateText",
      "skippable": true
    },
    {
      "id": "step5",
      "screen": "feelHundredCurrentState",
      "quoteSource": "currentStateText",
      "skippable": true
    },
    {
      "id": "step6",
      "screen": "idealStateInput",
      "quoteSource": "currentStateText",
      "responseTarget": "idealStateText",
      "skippable": true
    },
    {
      "id": "step7",
      "screen": "breath",
      "phases": [
        "first",
        "second"
      ],
      "skippable": true
    },
    {
      "id": "step8",
      "screen": "currentStateAfterMeasurement",
      "quoteSource": "currentStateText",
      "skippable": true
    },
    {
      "id": "step9",
      "screen": "result",
      "skippable": true
    }
  ],
  "finalThemeMeasurement": {
    "screen": "finalThemeMeasurement",
    "quoteSource": "theme",
    "condition": "noCurrentStateTextAnswer",
    "skippable": true
  },
  "resultFields": [
    "theme",
    "currentStateText",
    "currentStateBeforeScore",
    "currentStateAfterScore",
    "idealStateText"
  ],
  "loops": {
    "anotherClearing": {
      "returnTo": "step5",
      "beforeScoreSource": "latestStep8",
      "preserve": [
        "theme",
        "currentStateText"
      ]
    },
    "restartTheme": {
      "returnTo": "step2",
      "preserve": [
        "theme"
      ]
    },
    "chooseThemeAgain": {
      "returnTo": "step0",
      "resetSession": true
    }
  }
}
