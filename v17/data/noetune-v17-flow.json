{
  "version": "5.0",
  "appVersion": "v17",
  "localeSource": "locales/{locale}.json",
  "themeSource": "v17/data/theme-library-{locale}.json",
  "routeSource": "themeTrackId",
  "routes": [
    "problems",
    "ideals"
  ],
  "themeSelection": {
    "categoriesSource": "themeSource",
    "libraryCategoryCount": 8,
    "appendFreeInputCategory": true,
    "tracks": [
      "problems",
      "ideals"
    ],
    "trackFreeInput": true,
    "themePageSize": 4,
    "freeInputCategoryUsesLibraryThemes": false
  },
  "sequence": [
    {
      "id": "step0",
      "screen": "themeSelection",
      "routeValues": {
        "problems": "problems",
        "ideals": "ideals"
      },
      "skippable": true
    },
    {
      "id": "step1",
      "screen": "initialThemeMeasurement",
      "quoteSource": "theme",
      "responseTarget": "initialThemeScore",
      "skippable": true
    },
    {
      "id": "step2",
      "screen": "firstResponseInput",
      "quoteSource": "theme",
      "responseTargetByRoute": {
        "problems": "idealStateText",
        "ideals": "currentStateText"
      },
      "skippable": true
    },
    {
      "id": "step3",
      "screen": "secondResponseInput",
      "quoteSource": "step2Text",
      "responseTargetByRoute": {
        "problems": "currentStateText",
        "ideals": "idealStateText"
      },
      "skippable": true
    },
    {
      "id": "step4",
      "screen": "breath",
      "phases": [
        "first",
        "second"
      ],
      "skippable": true
    },
    {
      "id": "step5",
      "screen": "themeRemeasurement",
      "quoteSource": "theme",
      "responseTarget": "finalThemeScore",
      "skippable": true
    },
    {
      "id": "step6",
      "screen": "result",
      "skippable": true
    }
  ],
  "resultFields": [
    "theme",
    "themeTrackId",
    "currentStateText",
    "idealStateText",
    "initialThemeScore",
    "finalThemeScore"
  ],
  "resultActions": {
    "bookmark": {
      "preserveSession": true
    },
    "restartTheme": {
      "returnTo": "step1",
      "preserve": [
        "theme",
        "themeId",
        "themeCategoryId",
        "themeTrackId"
      ]
    },
    "chooseThemeAgain": {
      "returnTo": "step0",
      "resetSession": true
    }
  }
}
